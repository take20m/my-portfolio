---
interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  hrefLabel?: string;
  level?: 2 | 3;
}

const { eyebrow, title, href, hrefLabel = "View all", level = 2 } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
---

<header class="section-heading">
  <div class="lead">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading>{title}</Heading>
  </div>
  {
    href && (
      <a class="more" href={href}>
        {hrefLabel} <span aria-hidden="true">→</span>
      </a>
    )
  }
</header>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .lead {
    display: grid;
    gap: 0.5rem;
  }

  .more {
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
</style>
