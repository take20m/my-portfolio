---
import { nav, site } from "../data/site";

const currentPath = Astro.url.pathname.replace(/\/+$/, "/") || "/";
const isCurrent = (href: string) => {
  const normalized = href.replace(/\/+$/, "/") || "/";
  if (normalized === "/") return currentPath === "/";
  return currentPath.startsWith(normalized);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} — Home`}>
      <svg class="brand-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="m7 9 3 3-3 3" />
        <path d="M13 15h4" />
      </svg>
      <span class="brand-mark">{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    background: color-mix(in oklab, var(--c-bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--c-border);
    z-index: 50;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--c-fg);
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
  }

  .brand-icon {
    display: block;
    flex-shrink: 0;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-3);
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
  }

  nav a {
    text-decoration: none;
    color: var(--c-fg-muted);
    padding-block: 0.25rem;
  }

  nav a[aria-current="page"] {
    color: var(--c-fg);
    border-bottom: 1px solid var(--c-fg);
  }
</style>
