---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../data/site";

const skills = {
  Frontend: ["TypeScript", "React", "Astro", "Vite", "CSS"],
  Backend: ["Node.js", "Hono", "Cloudflare Workers"],
  Other: ["Git", "Cloudflare Pages", "Figma"],
};

const history = [
  {
    period: "2024 — Present",
    title: "Web Engineer",
    description: "現職。フロントエンド寄りのフルスタックとして開発に従事。",
  },
  {
    period: "2020 — 2024",
    title: "Web Developer",
    description: "受託開発を中心に、Web アプリケーションの設計と実装を担当。",
  },
];
---

<BaseLayout title="About" description={`${site.name} について`}>
  <section class="container about">
    <header class="page-header">
      <p class="eyebrow">About</p>
      <h1>このサイトと作っている人について</h1>
    </header>

    <div class="grid">
      <div class="bio">
        <h2 class="visually-hidden">プロフィール</h2>
        <p class="lead">{site.tagline}</p>
        <p>
          {site.name}（{site.handle}）です。
          日々のものづくりや、書いたコード、考えていることをこのサイトにまとめています。
          ミニマルな構成、読みやすいタイポグラフィ、必要なものだけが残るような設計を心掛けています。
        </p>
        <p class="muted small">
          ※ 自己紹介の本文・写真は受領後に差し替え予定のプレースホルダです。
        </p>
      </div>

      <aside class="meta">
        <h2 class="meta-heading eyebrow">Links</h2>
        <SocialLinks social={site.social} />
      </aside>
    </div>

    <div class="block">
      <h2 class="block-heading">Skills</h2>
      <dl class="skills">
        {
          Object.entries(skills).map(([category, items]) => (
            <div class="skill-row">
              <dt>{category}</dt>
              <dd>
                <ul>
                  {items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="block">
      <h2 class="block-heading">History</h2>
      <ol class="history">
        {
          history.map((row) => (
            <li>
              <p class="history-period mono">{row.period}</p>
              <h3 class="history-title">{row.title}</h3>
              <p class="history-desc muted">{row.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-5) var(--space-6);
  }

  .page-header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: var(--space-5);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-6);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: 2fr 1fr;
      gap: var(--space-5);
    }
  }

  .lead {
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--c-fg);
    margin-bottom: var(--space-2);
  }

  .small {
    font-size: var(--fs-small);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .meta-heading {
    margin-bottom: var(--space-2);
  }

  .block {
    border-top: 1px solid var(--c-border);
    padding-top: var(--space-4);
    margin-top: var(--space-5);
  }

  .block-heading {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-3);
  }

  .skills {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--c-border);
  }

  @media (min-width: 640px) {
    .skill-row {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
    }
  }

  .skill-row dt {
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
    color: var(--c-fg-muted);
    letter-spacing: 0.04em;
  }

  .skill-row dd {
    margin: 0;
  }

  .skill-row ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    font-family: var(--ff-mono);
    font-size: var(--fs-small);
  }

  .skill-row li {
    border: 1px solid var(--c-border);
    padding: 0.2rem 0.55rem;
    color: var(--c-fg-muted);
  }

  .history {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .history li {
    display: grid;
    gap: 0.4rem;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--c-border);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .history li {
      grid-template-columns: 12rem 1fr;
      align-items: baseline;
      column-gap: var(--space-3);
    }
  }

  .history-period {
    font-size: var(--fs-small);
    color: var(--c-fg-soft);
  }

  .history-title {
    font-size: var(--fs-h3);
    margin: 0;
  }

  .history-desc {
    font-size: var(--fs-small);
    margin: 0.25rem 0 0;
  }
</style>
