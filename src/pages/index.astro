---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
import avatar from "../assets/profile/avatar.png";

const hobbies: string[] = [
  "旅行",
  "グルメ",
  "インターネット",
  "筋トレ",
  "野球観戦",
  "読書",
  "自作キーボード"
];

const skills: string[] = [
  "Java",
  "TypeScript",
  "Ruby",
  "Python",
  "AWS",
  "Cloudflare"
];

type HistoryIcon = "school" | "company";
interface HistoryItem {
  period: string;
  title: string;
  description: string;
  icon: HistoryIcon;
}

const history: HistoryItem[] = [
  {
    period: "2023/4 — 現在",
    title: "株式会社 jig.jp",
    description: "エンジニア (ライブ配信サービスのバックエンド)",
    icon: "company",
  },
  {
    period: "2021/08 — 2022/12",
    title: "POST URBAN.inc",
    description: "エンジニア インターン（受託開発のプロジェクトのフロントエンド・バックエンド）",
    icon: "company",
  },
  {
    period: "2018/4 — 2023/3",
    title: "国際基督教大学(ICU)",
    description: "教養学部アーツサイエンス学科 情報科学メジャー",
    icon: "school",
  }
];
---

<BaseLayout>
  <section class="section container fade-in" id="about">
    <h2 class="about-heading">About</h2>
    <div class="about-grid">
      <div class="about-bio">
        <p class="about-name">
          {site.name}
          {site.pronunciation && <span class="name-pron">-{site.pronunciation}-</span>}
        </p>
        <p class="about-lead">{site.tagline}</p>
        <p>
          体験したこと、作ったもの、考えたこと、読んだ本のメモなど雑多にまとめています。
        </p>
      </div>
      <figure class="about-avatar">
        <Image
          src={avatar}
          alt={`${site.name} のプロフィール画像`}
          widths={[220, 360, 560]}
          sizes="(min-width: 720px) 280px, 60vw"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="about-block">
      <h3 class="about-block-heading">Hobbies</h3>
      <p class="skills-list">{hobbies.join(" / ")}</p>
    </div>

    <div class="about-block">
      <h3 class="about-block-heading">Skills</h3>
      <p class="skills-list">{skills.join(" / ")}</p>
    </div>

    <div class="about-block">
      <h3 class="about-block-heading">History</h3>
      <ol class="timeline">
        {
          history.map((row) => (
            <li class="timeline-item">
              <span class="timeline-icon" aria-hidden="true">
                {row.icon === "school" ? (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21V11l9-6 9 6v10" />
                    <path d="M3 21h18" />
                    <path d="M10 21v-6h4v6" />
                    <path d="M12 8.5v1.5" />
                  </svg>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="3" width="14" height="18" />
                    <path d="M9 7h.01M13 7h.01M9 11h.01M13 11h.01M9 15h.01M13 15h.01" />
                    <path d="M10 21v-3h4v3" />
                  </svg>
                )}
              </span>
              <div class="timeline-body">
                <p class="timeline-period mono">{row.period}</p>
                <p class="timeline-title">{row.title}</p>
                <p class="timeline-sub muted">{row.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-5);
    align-items: start;
  }

  @media (min-width: 720px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-5);
      align-items: center;
    }
  }

  .about-bio {
    max-width: 56ch;
    display: grid;
    gap: var(--space-2);
  }

  .about-heading {
    font-size: var(--fs-h2);
    margin: 0 0 var(--space-3);
    letter-spacing: var(--ls-tight);
  }

  .about-name {
    margin: 0;
    font-size: var(--fs-body);
    color: var(--c-fg);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
  }

  .name-pron {
    font-family: var(--ff-mono);
    color: var(--c-fg-muted);
    font-size: var(--fs-small);
  }

  .about-lead {
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--c-fg);
    margin: var(--space-2) 0 var(--space-1);
  }

  .about-bio p {
    margin: 0;
  }

  .about-bio p + p {
    margin-top: var(--space-2);
  }

  .about-avatar {
    margin: 0;
    width: clamp(180px, 28vw, 280px);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--c-surface);
    justify-self: center;
  }

  .about-avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-block {
    border-top: 1px solid var(--c-border);
    padding-top: var(--space-4);
    margin-top: var(--space-5);
  }

  .about-block-heading {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-3);
  }

  .skills-list {
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-snug);
    color: var(--c-fg);
    word-break: break-word;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    column-gap: var(--space-3);
    padding-bottom: var(--space-4);
    list-style: none;
  }

  .timeline-item::marker {
    content: "";
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(0.875rem - 0.5px);
    top: 2.1rem;
    bottom: -0.25rem;
    width: 1px;
    background: var(--c-border);
  }

  .timeline-icon {
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    color: var(--c-fg);
    margin-top: 0.15rem;
    background: var(--c-bg);
    position: relative;
    z-index: 1;
  }

  .timeline-icon svg {
    width: 1.375rem;
    height: 1.375rem;
    display: block;
  }

  .timeline-body {
    display: grid;
    gap: 0.15rem;
  }

  .timeline-period {
    font-size: var(--fs-small);
    color: var(--c-fg-muted);
    margin: 0;
  }

  .timeline-title {
    font-size: 1.125rem;
    margin: 0;
    font-weight: 600;
    line-height: var(--lh-snug);
  }

  .timeline-sub {
    font-size: var(--fs-small);
    margin: 0;
  }
</style>
